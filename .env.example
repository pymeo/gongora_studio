# Plantilla de ~/.config/gongora/secrets.env   (chmod 600)
# NO escribir valores reales en este fichero de ejemplo: va al repositorio.

# --- Obligatorio: Instagram API with Facebook Login ---
# Flujo sobre graph.facebook.com. NO usar Instagram Login ni instagram_business_*.
META_ACCESS_TOKEN=
META_AUTH_FLOW=facebook_login
META_GRAPH_VERSION=v26.0
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# --- Opcional: necesario solo para conseguir acceso duradero ---
# Con estos dos valores, `gongora token renew --write` cambia un token de
# corta duracion por uno de usuario de larga duracion (~60 dias) y luego
# obtiene el token de Pagina, que no caduca.
# Se obtienen en developers.facebook.com -> tu app -> Configuracion -> Basica
META_APP_ID=
META_APP_SECRET=

# --- TikTok: plantilla de ~/.config/gongora/tiktok.env (chmod 600) ---
# Fichero aparte del de Meta. Tambien se aceptan como variables de entorno.
# Solo rellenas CLIENT_KEY y CLIENT_SECRET; los tokens los escribe
# `gongora tiktok login`. Ver docs/tiktok-conexion.md.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
